{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WidgetCore",
  "version": "0.1.0",
  "identifier": "com.widgetcore.hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WidgetCore Hub",
        "label": "main",
        "width": 980,
        "height": 680,
        "minWidth": 820,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
